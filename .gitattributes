# 统一换行符：源码一律 LF，避免 Windows 下 CRLF 造成的整文件 diff
* text=auto

*.v      text eol=lf
*.vh     text eol=lf
*.sv     text eol=lf
*.cst    text eol=lf
*.sdc    text eol=lf
*.tcl    text eol=lf
*.gprj   text eol=lf
*.md     text eol=lf
*.py     text eol=lf
*.html   text eol=lf
*.json   text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# 二进制
*.bin    binary
*.fs     binary
*.bit    binary
